@model DemoMVC.Models.Student

<h2>Edit Student</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="StudentCode"></label>
        <input asp-for="StudentCode" />
    </div>

    <div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
    </div>

    <button type="submit">
        Save
    </button>

</form>